{
  "name": "miniledger",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace=@miniledger/api",
    "dev:api": "npm run dev --workspace=@miniledger/api",
    "dev:mobile": "npm run start --workspace=@miniledger/mobile",
    "dev:android": "npm run android --workspace=@miniledger/mobile",
    "dev:ios": "npm run ios --workspace=@miniledger/mobile",
    "test": "npm run test --workspace=@miniledger/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.1",
    "drizzle-orm": "^0.36.1",
    "prettier": "2.8.8"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
